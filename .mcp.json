{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "task-master-ai": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "task-master-ai@0.43.1"
      ],
      "env": {
        "TASK_MASTER_TOOLS": "initialize_project,get_tasks,next_task,get_task,set_task_status,add_task,add_subtask,remove_task,remove_subtask,clear_subtasks,move_task,add_dependency,remove_dependency,validate_dependencies,fix_dependencies,generate,list_tags,add_tag,use_tag,rename_tag,copy_tag,delete_tag"
      }
    },
    "momorph": {
      "type": "http",
      "url": "https://app.momorph.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${MOMORPH_API_KEY}"
      }
    }
  }
}