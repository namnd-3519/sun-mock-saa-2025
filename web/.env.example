# Copy to web/.env.local and fill in. Never commit .env.local.
# Local values come from `supabase status` (run in backend/) after `supabase start`.

# API URL of the Supabase project ("Project URL" in `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key ("Publishable" in `supabase status`, starts with sb_publishable_).
# Safe for the browser only because every table enables Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Launch time of SAA 2025 (ISO-8601 with offset, Asia/Ho_Chi_Minh = +07:00).
# While now < this value every page shows the prelaunch countdown. Unset = no gate.
SAA_LAUNCH_AT=

# Start of the SAA 2025 ceremony for the homepage countdown (ISO-8601 with offset).
# Unset = 2025-12-26T18:30:00+07:00 (the date on the design).
SAA_EVENT_AT=
