# Copy to web/.env.local and fill in. Never commit .env.local.
# Local values come from `supabase status` (run in backend/) after `supabase start`.

# API URL of the Supabase project ("Project URL" in `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key ("Publishable" in `supabase status`, starts with sb_publishable_).
# Safe for the browser only because every table enables Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
